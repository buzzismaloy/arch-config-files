{
	// Language(hyprland)
	"hyprland/language": {
		"format": "{shortDescription} 󰌌 "
	},

	// Tray
	"tray": {
		"icon-size": 20,
		"spacing": 8,
		"show-passive-items": true,
		"reverse-direction": false,
		"smooth-scrolling-threshold": 1.0
	},

	// Hyprland Workspaces
	"hyprland/workspaces": {
		"format": "{name}: {icon}",
		"on-click": "activate",
		"active-only": false,
		"all-outputs": false,
		"format-icons": {
			"active": "",
			"urgent": "",
			"default": ""
		},
		"sort_by_number": true,
		"persistent-workspaces": {
			"*": 5, //5 workspaces by defaul on every monitor
		},
	},

	// Hyprland window
	"hyprland/window": {
		"format": "{}",
		"max-length": 20,
		"rewrite": {
			"": "Desktop",
			".*Firefox.*": "Firefox",
			"^~$": "Kitty terminal",
			"^vim ~?$": "Vim"
		},
		"tooltip": false,
		"separate-outputs": true
	},

	// Time and calendar
	"clock": {
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"format": "{:%I:%M%p %a}",
		"format-alt": "{:%Y-%m-%d}",
		"interval": 30,
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
			}
		}
	},

	// CPU, RAM, Temperature
	"cpu": {
		"format": "CPU: {usage}%",
		"tooltip": true
	},

	"memory": {
		"format": "RAM: {}%",
		"tooltip": true,
		"interval": 20
	},

	"temperature": {
		"format": "{icon} {temperatureC}°C",
		"format-icons": ["", "", ""],
		"tooltip": false,
		"critical-threshold": 80
	},

	// Battery
	"battery": {
		"interval": 5,
		"states": {
			"warning": 25,
			"critical": 15
		},
		"format": "{icon}  {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-icons": ["", "", "", "", ""]
	},

	// Network
	"network": {
		"format-wifi": "  {bandwidthDownBits}",
		"format-ethernet": "  {cidr}",
		"format-disconnected": "⚠",
		"tooltip-format": "  {ifname} via {gwaddr}",
		"tooltip-format-wifi": "  {essid}\nStr: {signalStrength}%\nUp: {bandwidthUpBits}\nDown: {bandwidthDownBits}",
		"tooltip-format-ethernet": "  {ifname}/{cidr}\nIP: {ipaddr}\nUp: {bandwidthUpBits}\nDown: {bandwidthDownBits}",
		"tooltip-format-disconnected": "Disconnected ⚠",
		"format-linked": "{ifname} (No IP) ",
		"format-alt": "{ifname}: {ipaddr}/{cidr}",
		"on-click-right": "exec kitty -e nmtui-connect",
		"interval": 3,
		"max-length": 50
	},

	// Bluetooth
	"bluetooth": {
		"format": " {status}",
		"format-disabled": " off",
		"format-off" : " disabled",
		"format-connected": " connected",
		"format-connected-battery": " {device_battery_percentage}%",
		"format-no-controller": "no ctrller",
		"format-alt": " {device_alias}",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
		"tooltip-format-disabled": "Bluetooth Disabled",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",

		"on-click-right": "blueman-manager",
		"interval": 5,
	},

	// Backlight
	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": ["", ""],
		"tooltip": true,
		"tooltip-format": "Scroll with the mouse wheel",
		"on-scroll-down": "brightnessctl set 5%-",
		"on-scroll-up": "brightnessctl set +5%"
	},

	// Audio
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-bluetooth": "{volume}% {icon}",
		"format-bluetooth-muted": " {icon}",
		"format-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
      "on-click": "pavucontrol"
	},

	// Microphone
	"pulseaudio#microphone": {
		"format": "{format_source}",
		"format-source": " {volume}%",
		"format-source-muted": "",
		"on-click": "pavucontrol",
		"tooltip": true,
	},

	// Powermenu
	"custom/powermenu": {
		"format": "⏻",
		"tooltip": false,
		"on-click": "wlogout -b 2"
	},

	// Launcher wofi
	"custom/launcher": {
		"format": "",
		"on-click": "~/.config/wofi/scripts/smart-launcher.sh",
		"tooltip": false
	},

	// Keyboard state
	"keyboard-state": {
		"capslock": true,
		"format": {
			"capslock": "{name} {icon}"
		},
		"format-icons": {
			"locked": " ",
			"unlocked": ""
		}
	},

	// Idle inhibitor
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "󰌾",
			"deactivated": "󰌵"
		},
		"tooltip-format-activated": "Idle inhibitor: ON",
		"tooltip-format-deactivated": "Idle inhibitor: OFF"
	}
}
