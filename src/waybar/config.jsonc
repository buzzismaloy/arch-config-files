{
	"style": "~/.config/waybar/style.css",

	"position": "top",
	"layer": "top",
	"height": 30,

	"modules-left": [
		"custom/launcher",
		"hyprland/workspaces",
		"hyprland/language",
		"tray"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		"group/hardware",
		"battery",
		"backlight",
		"group/volume",
		"group/connections",
		"clock",
		"custom/powermenu"
	],

	"group/hardware": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"children-class" : "not-hardware",
			"transition-left-to-right": false,
		},
		"modules": [
		"temperature",
		"cpu",
		"memory",
		]
    },

	"group/connections" : {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"children-class" : "not-connections",
			"transition-left-to-right": false,
		},
		"modules": [
			"network",
			"bluetooth",
		]
	},

	"group/volume": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"children-class" : "not-volume",
			"transition-left-to-right": false,
		},
		"modules": [
			"pulseaudio",
			//"backlight",
			"pulseaudio#microphone"
		]
	},

	"include": "~/.config/waybar/modules.jsonc"
}
